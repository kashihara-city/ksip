<?xml version="1.0" encoding="utf-8"?>
<!-- KSIP: the settings a site decides for its users, as per-user policy values (HKCU\Software\Policies\KashiharaCity\ksip) that KSIP prefers to the user's own and locks. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="ksip" namespace="KashiharaCity.Policies.KSIP" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_KSIP" displayName="$(string.SUPPORTED_KSIP)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="KashiharaCity" displayName="$(string.Category_KashiharaCity)" />
    <category name="KSIP" displayName="$(string.Category_KSIP)">
      <parentCategory ref="KashiharaCity" />
    </category>
    <category name="Connection" displayName="$(string.Category_Connection)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Audio" displayName="$(string.Category_Audio)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Calls" displayName="$(string.Category_Calls)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Links" displayName="$(string.Category_Links)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Buttons" displayName="$(string.Category_Buttons)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Other" displayName="$(string.Category_Other)">
      <parentCategory ref="KSIP" />
    </category>
