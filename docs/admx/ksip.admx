<?xml version="1.0" encoding="utf-8"?>
<!-- KSIP: every setting a site may want to set, as the per-user registry values the app reads (HKCU\Software\KashiharaCity\ksip). -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="ksip" namespace="KashiharaCity.Policies.KSIP" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_KSIP" displayName="$(string.SUPPORTED_KSIP)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="KSIP" displayName="$(string.Category_KSIP)" />
    <category name="Account" displayName="$(string.Category_Account)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Connection" displayName="$(string.Category_Connection)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Audio" displayName="$(string.Category_Audio)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Calls" displayName="$(string.Category_Calls)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Browser" displayName="$(string.Category_Browser)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Display" displayName="$(string.Category_Display)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Sounds" displayName="$(string.Category_Sounds)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="ButtonsPhone" displayName="$(string.Category_ButtonsPhone)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="ButtonsPanel" displayName="$(string.Category_ButtonsPanel)">
      <parentCategory ref="KSIP" />
    </category>
    <category name="Diagnostics" displayName="$(string.Category_Diagnostics)">
      <parentCategory ref="KSIP" />
    </category>
  </categories>
  <policies>
    <policy name="server" class="User" displayName="$(string.server)" explainText="$(string.server_Help)" presentation="$(presentation.server)" key="Software\KashiharaCity\ksip">
      <parentCategory ref="Account" />
      <supportedOn ref="SUPPORTED_KSIP" />
      <elements>
        <text id="server" valueName="server" maxLength="253" />
      </elements>
    </policy>
    <policy name="port" class="User" displayName="$(string.port)" explainText="$(string.port_Help)" presentation="$(presentation.port)" key="Software\KashiharaCity\ksip">
      <parentCategory ref="Account" />
      <supportedOn ref="SUPPORTED_KSIP" />
      <elements>
        <decimal id="port" valueName="port" required="true" minValue="1" maxValue="65535" />
      </elements>
    </policy>
    <policy name="transport" class="User" displayName="$(string.transport)" explainText="$(string.transport_Help)" presentation="$(presentation.transport)" key="Software\KashiharaCity\ksip">
      <parentCategory ref="Connection" />
      <supportedOn ref="SUPPORTED_KSIP" />
      <elements>
        <enum id="transport" valueName="transport" required="true">
          <item displayName="$(string.transport_0)">
            <value>
              <string>udp</string>
            </value>
          </item>
          <item displayName="$(string.transport_1)">
            <value>
              <string>tcp</string>
            </value>
          </item>
          <item displayName="$(string.transport_2)">
            <value>
              <string>tls</string>
            </value>
