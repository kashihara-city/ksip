{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KSIP",
  "version": "0.0.13",
  "identifier": "local.ksip.client",
  "build": {
    "frontendDist": "../src-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KSIP",
        "width": 520,
        "height": 672,
        "minWidth": 420,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
